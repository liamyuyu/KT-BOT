# Application Settings
APP_NAME=KT-BOT
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=7860

# Ollama Configuration (Epic 1)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=bge-large-zh
OLLAMA_TIMEOUT=300

# Jira Configuration (Epic 2)
JIRA_URL=https://your-company.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=

# Confluence Configuration (Epic 2)
CONFLUENCE_URL=https://your-company.atlassian.net/wiki
CONFLUENCE_EMAIL=your-email@company.com
CONFLUENCE_API_TOKEN=your_confluence_api_token_here
CONFLUENCE_SPACE_KEY=

# Database Configuration
DATABASE_URL=postgresql://localhost:5432/ktbot
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Vector Database Configuration (Epic 3)
VECTOR_STORE=chromadb
VECTOR_STORE_PATH=./data/vectordb
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# RAG Configuration (Epic 3, 9)
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_K=20
RERANK_K=5
SIMILARITY_THRESHOLD=0.6
ENABLE_RERANKER=true
RERANKER_MODEL=BAAI/bge-reranker-large

# Hybrid Search Configuration
VECTOR_WEIGHT=0.7
FULLTEXT_WEIGHT=0.3

# Authentication Configuration (Epic 6)
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:7860,http://localhost:3000

# File Upload
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.txt,.md,.xlsx,.xls

# Performance Monitoring (Epic 8)
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=false

# Sync Configuration (Epic 2)
SYNC_INTERVAL_MINUTES=60
ENABLE_AUTO_SYNC=true

# Logging
LOG_FILE_PATH=./data/logs/app.log
LOG_ROTATION=1 day
LOG_RETENTION=30 days
