# ============================================================================
# KT-BOT Environment Configuration
# ============================================================================
# This file contains all environment variables needed to run KT-BOT.
# Copy this file to .env and customize the values for your environment.
#
# Usage:
#   cp .env.example .env
#   nano .env  # Edit with your values
#
# For production deployment, see docs/DEPLOYMENT.md
# ============================================================================

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME=KT-BOT
APP_VERSION=0.3.0
ENVIRONMENT=development  # Options: development, staging, production
DEBUG=true              # Set to false in production
LOG_LEVEL=INFO          # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
HOST=0.0.0.0
PORT=7860

# Secret Key for JWT and session encryption
# IMPORTANT: Generate a strong secret key for production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-strong-secret-key-in-production

# ============================================================================
# OLLAMA CONFIGURATION (Epic 1 - Model Management)
# ============================================================================
# Ollama server URL (local or remote)
OLLAMA_HOST=http://localhost:11434
# In Docker: http://ollama:11434

# Default chat model
# Options: qwen2.5:7b, qwen2.5:14b, llama3.1:8b, mistral:7b
OLLAMA_MODEL=qwen2.5:7b

# Embedding model for RAG
# Options: bge-large-zh, bge-base-zh, all-minilm, mxbai-embed-large
OLLAMA_EMBEDDING_MODEL=bge-large-zh

# Request timeout in seconds
OLLAMA_TIMEOUT=300

# Model temperature (0.0 - 2.0, lower = more deterministic)
OLLAMA_TEMPERATURE=0.7

# Maximum tokens to generate
OLLAMA_MAX_TOKENS=2048

# ============================================================================
# JIRA CONFIGURATION (Epic 2 - Data Integration)
# ============================================================================
# Jira Cloud URL (e.g., https://your-company.atlassian.net)
JIRA_URL=https://your-company.atlassian.net

# Jira user email
JIRA_EMAIL=your-email@company.com

# Jira API token (generate at: https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=your_jira_api_token_here

# Optional: Specific project key to sync (leave empty for all projects)
JIRA_PROJECT_KEY=

# Sync configuration
JIRA_SYNC_ENABLED=true
JIRA_SYNC_INTERVAL_MINUTES=60
JIRA_MAX_RESULTS_PER_REQUEST=100

# ============================================================================
# CONFLUENCE CONFIGURATION (Epic 2 - Data Integration)
# ============================================================================
# Confluence Cloud URL (e.g., https://your-company.atlassian.net/wiki)
CONFLUENCE_URL=https://your-company.atlassian.net/wiki

# Confluence user email (usually same as Jira)
CONFLUENCE_EMAIL=your-email@company.com

# Confluence API token (can be same as Jira token)
CONFLUENCE_API_TOKEN=your_confluence_api_token_here

# Optional: Specific space key to sync (leave empty for all spaces)
CONFLUENCE_SPACE_KEY=

# Sync configuration
CONFLUENCE_SYNC_ENABLED=true
CONFLUENCE_SYNC_INTERVAL_MINUTES=60
CONFLUENCE_MAX_RESULTS_PER_REQUEST=100

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================
# PostgreSQL connection URL
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://ktbot:ktbot_password@localhost:5432/ktbot
# In Docker: postgresql://ktbot:ktbot_password@postgres:5432/ktbot

# Database pool settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Database credentials (used by docker-compose)
POSTGRES_DB=ktbot
POSTGRES_USER=ktbot
POSTGRES_PASSWORD=ktbot_password
# IMPORTANT: Change password in production!

# ============================================================================
# REDIS CONFIGURATION (Cache & Session Store)
# ============================================================================
# Redis connection URL
# Format: redis://host:port/db
REDIS_URL=redis://localhost:6379/0
# In Docker: redis://redis:6379/0

# Cache TTL in seconds
REDIS_CACHE_TTL=1800  # 30 minutes

# Redis password (leave empty if no auth)
REDIS_PASSWORD=

# Redis max memory policy
REDIS_MAX_MEMORY=256mb
REDIS_MAX_MEMORY_POLICY=allkeys-lru

# ============================================================================
# VECTOR DATABASE CONFIGURATION (Epic 3 - RAG Engine)
# ============================================================================
# Vector store type: chromadb, qdrant, milvus
VECTOR_STORE=chromadb

# ChromaDB settings (default)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=ktbot_documents
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# Qdrant settings (alternative)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=ktbot_documents

# Milvus settings (alternative)
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
# MILVUS_COLLECTION=ktbot_documents

# ============================================================================
# RAG CONFIGURATION (Epic 3, 9 - Retrieval & Generation)
# ============================================================================
# Document chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MIN_CHUNK_SIZE=100
MAX_CHUNK_SIZE=2000

# Retrieval settings
RETRIEVAL_K=20              # Number of documents to retrieve initially
RERANK_K=5                  # Number of documents after reranking
SIMILARITY_THRESHOLD=0.6    # Minimum similarity score (0.0-1.0)

# Reranker configuration
ENABLE_RERANKER=true
RERANKER_MODEL=BAAI/bge-reranker-large
RERANKER_DEVICE=cpu        # Options: cpu, cuda, mps

# Hybrid search configuration
ENABLE_HYBRID_SEARCH=true
VECTOR_WEIGHT=0.7          # Weight for vector search (0.0-1.0)
FULLTEXT_WEIGHT=0.3        # Weight for full-text search (0.0-1.0)
FUSION_METHOD=rrf          # Options: rrf, weighted, linear

# BM25 settings
BM25_K1=1.5
BM25_B=0.75
BM25_CACHE_DIR=./data/bm25_cache

# ============================================================================
# AUTHENTICATION CONFIGURATION (Epic 6 - Multi-user)
# ============================================================================
# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Session settings
SESSION_COOKIE_NAME=ktbot_session
SESSION_COOKIE_SECURE=false  # Set to true in production with HTTPS
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax  # Options: lax, strict, none

# Admin user (created on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
ADMIN_USERNAME=admin

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:7860,http://localhost:3000,http://localhost:8080
# In production, set to your domain: https://ktbot.yourcompany.com

CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# ============================================================================
# FILE UPLOAD CONFIGURATION (Epic 7 - Local Documents)
# ============================================================================
# Maximum upload size in MB
MAX_UPLOAD_SIZE_MB=50

# Maximum number of files per upload
MAX_FILES_PER_UPLOAD=10

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.txt,.md,.html,.xlsx,.xls

# Upload directory
UPLOAD_DIR=./data/uploads

# File processing settings
ENABLE_OCR=false           # Enable OCR for scanned PDFs
OCR_LANGUAGE=chi_sim       # Options: eng, chi_sim, chi_tra

# ============================================================================
# PERFORMANCE MONITORING (Epic 8 - Metrics & Observability)
# ============================================================================
# Enable Prometheus metrics
ENABLE_METRICS=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Enable distributed tracing
ENABLE_TRACING=false
JAEGER_HOST=localhost
JAEGER_PORT=6831

# Enable profiling (development only)
ENABLE_PROFILING=false

# Logging configuration
LOG_FILE_PATH=./data/logs/app.log
LOG_ROTATION=1 day
LOG_RETENTION=30 days
LOG_MAX_SIZE=100MB
LOG_FORMAT=json           # Options: json, text

# ============================================================================
# SYNC SCHEDULER CONFIGURATION (Epic 2 - Data Synchronization)
# ============================================================================
# Enable automatic synchronization
ENABLE_AUTO_SYNC=true

# Sync interval in minutes
SYNC_INTERVAL_MINUTES=60

# Sync concurrency (max parallel sync jobs)
SYNC_MAX_WORKERS=3

# Sync retry settings
SYNC_MAX_RETRIES=3
SYNC_RETRY_DELAY_SECONDS=60

# Initial sync on startup
SYNC_ON_STARTUP=true

# ============================================================================
# RATE LIMITING
# ============================================================================
# Enable rate limiting
ENABLE_RATE_LIMITING=true

# Rate limit per user (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# Rate limit per IP (requests per minute)
RATE_LIMIT_IP_PER_MINUTE=100

# Burst size
RATE_LIMIT_BURST=10

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================
# Enable automatic backups
ENABLE_AUTO_BACKUP=true

# Backup interval (cron expression)
BACKUP_CRON=0 2 * * *      # Daily at 2 AM

# Backup retention days
BACKUP_RETENTION_DAYS=30

# Backup directory
BACKUP_DIR=./backups

# Backup includes
BACKUP_DATABASE=true
BACKUP_REDIS=true
BACKUP_CHROMA=true
BACKUP_UPLOADS=true

# ============================================================================
# EMAIL CONFIGURATION (Optional - for notifications)
# ============================================================================
# SMTP settings
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Email notification settings
EMAIL_FROM=noreply@ktbot.com
EMAIL_FROM_NAME=KT-BOT System
ADMIN_EMAIL_ALERTS=admin@example.com

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable/disable features
FEATURE_CHAT_HISTORY=true
FEATURE_FILE_UPLOAD=true
FEATURE_MULTI_USER=false
FEATURE_SSO=false
FEATURE_API_KEYS=false
FEATURE_WEBHOOKS=false

# ============================================================================
# DEVELOPMENT & DEBUGGING
# ============================================================================
# Development mode settings (disable in production)
DEV_MODE=true
DEV_RELOAD=true            # Auto-reload on code changes
DEV_MOCK_OLLAMA=false      # Use mock Ollama for testing

# SQL query logging
SQL_ECHO=false             # Print all SQL queries (verbose)

# Enable debug endpoints
DEBUG_ENDPOINTS=true       # Exposes /debug/* endpoints

# Seed data on startup (development only)
SEED_DATA_ON_STARTUP=false

# ============================================================================
# DOCKER-SPECIFIC CONFIGURATION
# ============================================================================
# Container memory limits (used in docker-compose)
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_MEMORY_RESERVATION=1g

# Container CPU limits
CONTAINER_CPU_LIMIT=2.0
CONTAINER_CPU_RESERVATION=0.5

# Restart policy
CONTAINER_RESTART_POLICY=unless-stopped

# ============================================================================
# HEALTH CHECK CONFIGURATION
# ============================================================================
# Health check settings
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=60s

# Health check endpoints
HEALTH_CHECK_DB=true
HEALTH_CHECK_REDIS=true
HEALTH_CHECK_OLLAMA=true
HEALTH_CHECK_CHROMA=true

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
# Security headers
ENABLE_SECURITY_HEADERS=true

# Content Security Policy
CSP_ENABLED=true
CSP_DIRECTIVES=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'

# HTTPS settings (production only)
FORCE_HTTPS=false
HTTPS_REDIRECT=false
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000

# Request size limits
MAX_REQUEST_SIZE_MB=100
MAX_HEADER_SIZE_KB=8

# ============================================================================
# PRODUCTION OPTIMIZATION
# ============================================================================
# Worker processes (for Gunicorn/Uvicorn)
WORKERS=4
WORKER_CLASS=uvicorn.workers.UvicornWorker
WORKER_TIMEOUT=300
WORKER_MAX_REQUESTS=1000
WORKER_MAX_REQUESTS_JITTER=50

# Database connection pooling
DB_POOL_PRE_PING=true
DB_POOL_ECHO_POOL=false

# Static file caching
STATIC_FILE_CACHE_MAX_AGE=86400  # 1 day in seconds

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
# For more information, see docs/DEPLOYMENT.md
